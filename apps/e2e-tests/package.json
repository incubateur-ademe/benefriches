{
  "name": "e2e-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --import=tsx --test 'monkey/**/*.spec.ts'",
    "test:monkey-browser": "node --import=tsx --test 'monkey/**/*.browser-spec.ts'",
    "test:headless": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format:check": "prettier --check --cache \"./**/*.{js,ts,json}\" .",
    "format": "prettier --write --cache \"./**/*.{js,ts,json}\" .",
    "monkey": "tsx monkey/run.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "~4.14.0",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "~26.6.6",
    "eslint-plugin-playwright": "~2.12.2",
    "tsx": "~4.23.15"
  }
}
