{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "pnpm start:dev",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --import ./test/swc-esm-loader.mjs --test 'src/**/*.spec.ts'",
    "test:integration": "node --import ./test/swc-esm-loader.mjs --import ./test/integration-per-test-hooks.ts --test-global-setup=./test/integration-global-setup.mts --test-concurrency=1 --test 'src/**/*.integration-spec.ts'",
    "test:integration:file": "node --import ./test/swc-esm-loader.mjs --import ./test/integration-per-test-hooks.ts --test-global-setup=./test/integration-global-setup.mts --test-concurrency=1 --test",
    "lint": "oxlint",
    "format": "prettier --write --cache \"./**/*.{js,jsx,ts,tsx,css,md,json}\" src/ test/ data/",
    "format:check": "prettier --check --cache  \"./**/*.{js,jsx,ts,tsx,css,md,json}\" src/ test/ data/",
    "knex": "tsx node_modules/knex/bin/cli.js",
    "knex:new-migration": "pnpm knex migrate:make -x ts --knexfile=src/shared-kernel/adapters/sql-knex/knexfile.ts",
    "knex:migrate-latest": "pnpm knex migrate:latest --knexfile=src/shared-kernel/adapters/sql-knex/knexfile.ts",
    "knex:migrate-latest:js": "node node_modules/knex/bin/cli.js migrate:latest --knexfile=dist/src/shared-kernel/adapters/sql-knex/knexfile.js",
    "knex:migrate-rollback": "pnpm knex migrate:rollback --knexfile=src/shared-kernel/adapters/sql-knex/knexfile.ts",
    "knex:seed-make": "pnpm knex seed:make --knexfile=src/shared-kernel/adapters/sql-knex/knexfile.ts",
    "knex:seed-run": "pnpm knex seed:run --knexfile=src/shared-kernel/adapters/sql-knex/knexfile.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "^1.16.2",
    "@trivago/prettier-plugin-sort-imports": "~6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "~5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/geojson": "~7946.0.16",
    "@types/node": "~26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "~8.23.1",
    "@types/supertest": "~7.2.1",
    "cookie": "^2.0.1",
    "dotenv": "~17.2.3",
    "globals": "~17.12.0",
    "supertest": "~7.3.0",
    "testcontainers": "~12.2.0",
    "ts-node": "~10.9.2",
    "tsx": "~4.23.15"
  },
  "dependencies": {
    "@nestjs/axios": "~12.0.1",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "~6.7.0",
    "axios": "~1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "date-fns": "~4.4.0",
    "dotenv": "~17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "knex": "~3.3.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.13",
    "openid-client": "^6.8.8",
    "pg": "~8.23.0",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2",
    "shared": "workspace:^",
    "uuid": "~14.0.2",
    "zod": "~4.6.1"
  }
}
