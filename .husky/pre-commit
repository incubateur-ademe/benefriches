if ! command -v talisman > /dev/null 2>&1; then
  echo "❌ Talisman is required. See https://github.com/thoughtworks/talisman"
  exit 1
fi
talisman --githook pre-commit

if git diff --cached --name-only | grep -qE '^\.(agents|claude)/skills(/|$)'; then
  pnpm agent-skills:check
fi

if git diff --cached --name-only | grep -qE '(^|/)\.env\.(example|e2e)$|^docker-compose\.e2e\.yml$|^scripts/check-env-files\.mjs$'; then
  pnpm env-files:check
fi

pnpm lint-staged
