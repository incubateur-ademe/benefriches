{
  "description": "Generated from the hooks in .claude/settings.json by `pnpm agent-config:sync`. Do not edit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/block-env-read.sh",
            "statusMessage": "Checking command for .env access..."
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/block-hook-bypass.mjs",
            "statusMessage": "Checking command for pre-commit bypass..."
          }
        ]
      }
    ]
  }
}
