{
  "name": "benefriches-root",
  "license": "MIT",
  "engines": {
    "node": "24",
    "pnpm": "11.5.2"
  },
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "prepare": "husky || true",
    "lint": "pnpm run -r lint",
    "format": "pnpm run -r format",
    "test": "pnpm run -r test",
    "format:check": "pnpm run -r format:check",
    "typecheck": "pnpm run -r typecheck",
    "build": "pnpm run -r build",
    "verify": "pnpm verify:static && pnpm verify:test",
    "verify:static": "pnpm agent-skills:check && pnpm agent-config:check && pnpm env-files:check && pnpm --filter shared build && pnpm typecheck && pnpm lint && pnpm format:check",
    "verify:test": "pnpm test:scripts && pnpm --filter shared build && pnpm test",
    "agent-skills:sync": "node scripts/sync-agent-skills.mjs",
    "agent-skills:check": "node scripts/sync-agent-skills.mjs --check",
    "agent-config:sync": "node scripts/sync-agent-config.mjs",
    "agent-config:check": "node scripts/sync-agent-config.mjs --check",
    "env-files:check": "node scripts/check-env-files.mjs",
    "test:scripts": "node --test \"scripts/**/*.spec.mjs\" \".tooling/**/*.spec.mjs\" \".claude/hooks/**/*.spec.mjs\""
  },
  "devDependencies": {
    "@playwright/mcp": "~0.0.82",
    "@upstash/context7-mcp": "4.0.7",
    "@vitest/coverage-v8": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "~3.9.9",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  }
}
